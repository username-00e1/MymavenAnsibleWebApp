localhost ansible_connection=local ansible_python_interpreter=/usr/bin/python3


- name: Deploy to Tomcat
  hosts: web
  become: yes
  tasks:
    - name: Copy WAR file to Tomcat
      copy:
        src: "/var/snap/jenkins/5013/workspace/MymavenAnsibleWebApp-CICD/target/MymavenAnsibleWebApp.war"
        dest: "/opt/tomcat/webapps/MymavenAnsibleWebApp.war"
        remote_src: no

    - name: Restart Tomcat
      systemd:
        name: tomcat
        state: restarted
